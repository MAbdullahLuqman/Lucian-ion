0:{"buildId":"Fyt4YRq1IfdTy96UldKPE","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"children":[["$","$L2",null,{"items":[{"label":"Home","to":"/"},{"label":"Rhinoplasty and nose reshaping","to":"/rhinoplasty"},{"label":"Reduction rhinoplasty"}]}],["$","$L3",null,{"eyebrow":"Rhinoplasty and nose reshaping","title":"Reduction rhinoplasty","standfirst":"The most frequent reason people ask about nose surgery: a nose that feels too prominent, too long or too wide for the face around it.","image":"/assets/nose-02.jpg","imageAlt":"Black and white profile study of a nose against a plain ground","actions":[["$","$L4",null,{"to":"/contact-us","children":"Book a consultation"}],["$","$L4",null,{"href":"#cases","variant":"outline","children":"View case studies"}]]}],["$","$L5",null,{"children":[["$","$L6",null,{"children":["$","$L7",null,{"index":"01","title":"The concern","id":"concern","children":["$","$L8",null,{"paragraphs":["Reduction can mean any of several things — less projection at the tip, a shorter nose, a narrower bridge, a softer hump on the profile, or a combination. Most people describe it as wanting the nose to stop being the first thing they see.","It is worth separating what bothers you from what you have been told bothers other people. A clear, specific description of your own concern is the most useful thing you can bring to a consultation."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"02","title":"Lucian's approach","id":"approach","children":["$","$L8",null,{"paragraphs":["Reduction is rarely subtraction alone. Taking away support can narrow the airway or let the tip drop over time, so structure is usually rebuilt as the size comes down.","Planning uses standard photographs and 3D images with computer simulation, so the direction of change can be agreed before the day. A simulation shows an intention; soft tissue thickness and healing decide how closely it can be met."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"03","title":"The consultation","id":"consultation","children":[["$","$L8",null,{"paragraphs":["Expect an examination of the outside and the inside of the nose, including how well you breathe through each side, and a discussion of anything you have been treated for before.","Photographs and imaging are taken so that the plan can be described in specific terms rather than adjectives, and so that follow-up can be compared fairly."]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":["$","$L4",null,{"to":"/contact-us","variant":"outline","children":"Contact the practice"}]}]]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"04","title":"Limitations","id":"limitations","children":["$","$L9",null,{"items":["Skin does not shrink to order. Thicker skin hides fine changes in the underlying framework.","A nose cannot be reduced beyond what its support and the airway will tolerate.","The result changes for many months as swelling resolves, and the tip settles last.","Perfect symmetry is not an achievable aim, in the nose or anywhere else."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"05","title":"Alternatives","id":"alternatives","children":["$","ul",null,{"className":"rule-t","children":[["$","li","Ultrasonic rhinoplasty, where bone reshaping is the main task",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/rhinoplasty/ultrasonic","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Ultrasonic rhinoplasty, where bone reshaping is the main task"}]}],["$","li","Chin augmentation, where profile balance is the real concern",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/facial-sculpting/chin-augmentation","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Chin augmentation, where profile balance is the real concern"}]}],"$Lb"]}]}]}],"$Lc","$Ld","$Le","$Lf"]}],"$L10","$L11"]}],null,"$L12"]}],"isPartial":"$@13","staleTime":"$14","varyParams":null},{"rsc":"$L15","isPartial":"$@16","staleTime":"$14","varyParams":null},{"rsc":"$L17","isPartial":"$@18","staleTime":"$14","varyParams":"$19"}],"isUpgradeableISRFallback":false,"a":"$@1a","rootVaryParams":null,"needsRuntimeRequest":"$@1b"}
