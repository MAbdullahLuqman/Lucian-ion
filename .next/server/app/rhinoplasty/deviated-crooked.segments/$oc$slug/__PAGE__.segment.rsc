0:{"buildId":"Fyt4YRq1IfdTy96UldKPE","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"children":[["$","$L2",null,{"items":[{"label":"Home","to":"/"},{"label":"Rhinoplasty and nose reshaping","to":"/rhinoplasty"},{"label":"Deviated / crooked nose"}]}],["$","$L3",null,{"eyebrow":"Rhinoplasty and nose reshaping","title":"Deviated and crooked nose","standfirst":"A nose that sits off the midline, whether it grew that way or was injured, usually involves both appearance and breathing.","image":"/assets/nose-04.jpg","imageAlt":"Black and white frontal portrait study in soft light","actions":[["$","$L4",null,{"to":"/contact-us","children":"Book a consultation"}],["$","$L4",null,{"href":"#cases","variant":"outline","children":"View case studies"}]]}],["$","$L5",null,{"children":[["$","$L6",null,{"children":["$","$L7",null,{"index":"01","title":"The concern","id":"concern","children":["$","$L8",null,{"paragraphs":["Crookedness may be in the bones, the septum, the cartilage of the tip, or all three, and the face behind it is often slightly asymmetric too. That combination is what makes these operations demanding.","Many patients notice the breathing before the shape, or only realise how much they had adapted once it is corrected."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"02","title":"Lucian's approach","id":"approach","children":["$","$L8",null,{"paragraphs":["Straightening means releasing what is holding the nose off-centre and then supporting it in its new position, which is why correction and reconstruction happen in the same operation.","The septum is usually part of the work, because the outside and the inside of the nose share the same framework."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"03","title":"The consultation","id":"consultation","children":[["$","$L8",null,{"paragraphs":["Examination includes the septum and the airway on each side, and photographs that record the asymmetry of the face as well as the nose.","Any history of injury, previous surgery or nasal treatment is relevant and worth bringing details of."]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":["$","$L4",null,{"to":"/contact-us","variant":"outline","children":"Contact the practice"}]}]]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"04","title":"Limitations","id":"limitations","children":["$","$L9",null,{"items":["A nose has a memory: some drift back towards the original position can occur.","Facial asymmetry behind the nose is not corrected by nose surgery and can still be visible.","Improved breathing is an aim, not a guarantee, and allergy or lining problems are separate issues."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"05","title":"Alternatives","id":"alternatives","children":["$","ul",null,{"className":"rule-t","children":[["$","li","Ultrasonic rhinoplasty for precise bone work",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/rhinoplasty/ultrasonic","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Ultrasonic rhinoplasty for precise bone work"}]}],["$","li","Treating the airway alone, where appearance is not a concern",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/contact-us","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Treating the airway alone, where appearance is not a concern"}]}]]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"06","title":"Risks and complications","id":"risks","children":[["$","p",null,{"className":"measure mb-5 text-muted-foreground","children":"Every operation carries risk. This list is a starting point for the conversation, not a complete account; the risks that matter for you depend on your health and your anatomy and are discussed at consultation."}],["$","$L9",null,{"items":["Residual or recurrent deviation.","Breathing that does not improve as much as hoped.","Septal complications, which are discussed individually.","Bleeding, infection and delayed healing are possible after any operation.","Scars are permanent. Their position is planned; how they mature varies between people and cannot be promised.","Swelling and bruising settle unevenly, so an early appearance is not the final one.","Numbness or altered sensation near the operated area is common early on and can occasionally persist.","Asymmetry exists in every face and body before surgery and can still be visible afterwards.","A result may fall short of what was hoped for, and revision surgery is sometimes considered.","Anaesthetic carries its own risks, which the anaesthetist discusses separately."]}]]}]}],"$Lb","$Lc","$Ld"]}],"$Le","$Lf"]}],null,"$L10"]}],"isPartial":"$@11","staleTime":"$12","varyParams":null},{"rsc":"$L13","isPartial":"$@14","staleTime":"$12","varyParams":null},{"rsc":"$L15","isPartial":"$@16","staleTime":"$12","varyParams":"$17"}],"isUpgradeableISRFallback":false,"a":"$@18","rootVaryParams":null,"needsRuntimeRequest":"$@19"}
