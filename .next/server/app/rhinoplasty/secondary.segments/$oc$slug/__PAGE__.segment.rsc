0:{"buildId":"Fyt4YRq1IfdTy96UldKPE","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"children":[["$","$L2",null,{"items":[{"label":"Home","to":"/"},{"label":"Rhinoplasty and nose reshaping","to":"/rhinoplasty"},{"label":"Secondary rhinoplasty"}]}],["$","$L3",null,{"eyebrow":"Rhinoplasty and nose reshaping","title":"Secondary rhinoplasty","standfirst":"Also called revision rhinoplasty: among the most demanding operations in cosmetic surgery, and the one where expectations need the most care.","image":"/assets/nose-05.jpg","imageAlt":"Black and white profile study, close crop","actions":[["$","$L4",null,{"to":"/contact-us","children":"Book a consultation"}],["$","$L4",null,{"href":"#cases","variant":"outline","children":"View case studies"}]]}],["$","$L5",null,{"children":[["$","$L6",null,{"children":["$","$L7",null,{"index":"01","title":"The concern","id":"concern","children":["$","$L8",null,{"paragraphs":["Patients come after previous surgery with a shape they dislike, breathing that has worsened, or both. Scarring, missing support and unpredictable tissue make a second operation a different proposition from a first.","It is common to arrive tired of the process. Taking time over the assessment, rather than moving quickly to a date, tends to serve people better."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"02","title":"Lucian's approach","id":"approach","children":["$","$L8",null,{"paragraphs":["Secondary work is mostly about restoring structure before refining shape. What is missing has to be replaced, and only then can the outside be adjusted.","Previous operation notes and pre-operative photographs, if you can obtain them, genuinely change how a plan is made."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"03","title":"The consultation","id":"consultation","children":[["$","$L8",null,{"paragraphs":["Expect a longer assessment, careful examination of the airway, and a frank conversation about what a second operation can and cannot reach.","Timing since your last surgery is part of the discussion, and waiting is sometimes the right advice."]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":["$","$L4",null,{"to":"/contact-us","variant":"outline","children":"Contact the practice"}]}]]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"04","title":"Limitations","id":"limitations","children":["$","$L9",null,{"items":["Scarred tissue is less predictable and heals less evenly.","Support that has been removed can only be replaced, not recovered.","Aims are usually improvement rather than an ideal result, and further surgery is more likely than after a first operation."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"05","title":"Alternatives","id":"alternatives","children":["$","ul",null,{"className":"rule-t","children":[["$","li","Waiting longer before deciding",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/contact-us","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Waiting longer before deciding"}]}],["$","li","Addressing breathing only, where the shape is acceptable",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/rhinoplasty/deviated-crooked","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Addressing breathing only, where the shape is acceptable"}]}]]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"06","title":"Risks and complications","id":"risks","children":[["$","p",null,{"className":"measure mb-5 text-muted-foreground","children":"Every operation carries risk. This list is a starting point for the conversation, not a complete account; the risks that matter for you depend on your health and your anatomy and are discussed at consultation."}],["$","$L9",null,{"items":["A higher chance of needing further surgery than after a first rhinoplasty.","Less predictable healing and scarring inside the nose.","Recovery from a second site if support has to be taken from elsewhere.","Bleeding, infection and delayed healing are possible after any operation.","Scars are permanent. Their position is planned; how they mature varies between people and cannot be promised.","Swelling and bruising settle unevenly, so an early appearance is not the final one.","Numbness or altered sensation near the operated area is common early on and can occasionally persist.","Asymmetry exists in every face and body before surgery and can still be visible afterwards.","A result may fall short of what was hoped for, and revision surgery is sometimes considered.","Anaesthetic carries its own risks, which the anaesthetist discusses separately."]}]]}]}],"$Lb","$Lc","$Ld"]}],"$Le","$Lf"]}],null,"$L10"]}],"isPartial":"$@11","staleTime":"$12","varyParams":null},{"rsc":"$L13","isPartial":"$@14","staleTime":"$12","varyParams":null},{"rsc":"$L15","isPartial":"$@16","staleTime":"$12","varyParams":"$17"}],"isUpgradeableISRFallback":false,"a":"$@18","rootVaryParams":null,"needsRuntimeRequest":"$@19"}
