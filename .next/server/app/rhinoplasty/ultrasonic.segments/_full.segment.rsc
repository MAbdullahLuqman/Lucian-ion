15:["$","article",null,{"children":[["$","$L1d",null,{"items":[{"label":"Home","to":"/"},{"label":"Rhinoplasty and nose reshaping","to":"/rhinoplasty"},{"label":"Ultrasonic rhinoplasty"}]}],["$","$L1e",null,{"eyebrow":"Rhinoplasty and nose reshaping","title":"Ultrasonic rhinoplasty","standfirst":"Instruments developed to cut and reshape bone precisely, leaving the soft tissue around it alone. A way of working rather than a different operation.","image":"/assets/ultrasonic-02.jpg","imageAlt":"Black and white study of nasal profile in raking light","actions":[["$","$L1f",null,{"to":"/contact-us","children":"Book a consultation"}],["$","$L1f",null,{"href":"#cases","variant":"outline","children":"View case studies"}]]}],["$","$L6",null,{"children":[["$","$L20",null,{"children":["$","$L21",null,{"index":"01","title":"The concern","id":"concern","children":["$","$L22",null,{"paragraphs":["Where the bridge is wide, deviated or carries a hump, the bone has to be reshaped. Traditionally this was done with instruments that broke bone along lines that could not be fully controlled.","Ultrasonic instruments work on bone without cutting the soft tissue around it, which allows the shaping to be more deliberate."]}]}]}],["$","$L20",null,{"children":["$","$L21",null,{"index":"02","title":"Lucian's approach","id":"approach","children":["$","$L22",null,{"paragraphs":["Ultrasonic instrumentation is an established part of the practice and is used where precise bone work is what the plan requires. It is combined with the rest of the operation rather than replacing it.","Precision in the bone does not change the soft tissue over it, so skin thickness still determines how much of the shaping shows."]}]}]}],["$","$L20",null,{"children":["$","$L21",null,{"index":"03","title":"The consultation","id":"consultation","children":[["$","$L22",null,{"paragraphs":["The discussion is about what your nose needs, then whether ultrasonic instruments are the best way to achieve it.","Imaging is used in the same way as for any other rhinoplasty."]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":["$","$L1f",null,{"to":"/contact-us","variant":"outline","children":"Contact the practice"}]}]]}]}],["$","$L20",null,{"children":["$","$L21",null,{"index":"04","title":"Limitations","id":"limitations","children":["$","$L23",null,{"items":["It addresses bone. Cartilage, tip shape and skin need separate answers.","It is a technique, not a guarantee of a particular result or a faster recovery.","Access to the bone may make the operation longer than an equivalent conventional approach."]}]}]}],["$","$L20",null,{"children":["$","$L21",null,{"index":"05","title":"Alternatives","id":"alternatives","children":["$","ul",null,{"className":"rule-t","children":[["$","li","Conventional bone reshaping",{"className":"rule-b py-3","children":["$","$L5",null,{"href":"/rhinoplasty/reduction","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Conventional bone reshaping"}]}],["$","li","Correction of a crooked nose",{"className":"rule-b py-3","children":["$","$L5",null,{"href":"/rhinoplasty/deviated-crooked","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Correction of a crooked nose"}]}]]}]}]}],["$","$L20",null,{"children":["$","$L21",null,{"index":"06","title":"Risks and complications","id":"risks","children":[["$","p",null,{"className":"measure mb-5 text-muted-foreground","children":"Every operation carries risk. This list is a starting point for the conversation, not a complete account; the risks that matter for you depend on your health and your anatomy and are discussed at consultation."}],["$","$L23",null,{"items":["Bleeding, infection and delayed healing are possible after any operation.","Scars are permanent. Their position is planned; how they mature varies between people and cannot be promised.","Swelling and bruising settle unevenly, so an early appearance is not the final one.","Numbness or altered sensation near the operated area is common early on and can occasionally persist.","Asymmetry exists in every face and body before surgery and can still be visible afterwards.","A result may fall short of what was hoped for, and revision surgery is sometimes considered.","Anaesthetic carries its own risks, which the anaesthetist discusses separately."]}]]}]}],"$L24","$L25","$L26"]}],"$L27","$L28"]}]
