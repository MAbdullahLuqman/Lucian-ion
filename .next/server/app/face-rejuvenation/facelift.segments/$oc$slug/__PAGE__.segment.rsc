0:{"buildId":"Fyt4YRq1IfdTy96UldKPE","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"children":[["$","$L2",null,{"items":[{"label":"Home","to":"/"},{"label":"Face and neck rejuvenation","to":"/face-rejuvenation"},{"label":"Facelift"}]}],["$","$L3",null,{"eyebrow":"Face and neck rejuvenation","title":"Facelift","standfirst":"Repositioning the deeper layers of the face rather than pulling on the skin — the difference between looking rested and looking tightened.","image":"/assets/rejuvenation-02.jpg","imageAlt":"Black and white portrait study, three-quarter view","actions":[["$","$L4",null,{"to":"/contact-us","children":"Book a consultation"}],["$","$L4",null,{"href":"#cases","variant":"outline","children":"View case studies"}]]}],["$","$L5",null,{"children":[["$","$L6",null,{"children":["$","$L7",null,{"index":"01","title":"The concern","id":"concern","children":["$","$L8",null,{"paragraphs":["The changes people describe are usually descent rather than looseness: a heaviness at the jawline, a fold beside the mouth, a cheek that has slipped down and left a hollow behind it.","Most patients want to look like themselves on a good day. That is a reasonable aim and a useful way to describe it."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"02","title":"Lucian's approach","id":"approach","children":["$","$L8",null,{"paragraphs":["Work at the deeper layer allows tissue to be returned towards where it came from without tension on the skin, which is what keeps the result from looking stretched.","The neck is usually part of the same plan, because the jawline is where face and neck meet and treating one alone rarely reads well."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"03","title":"The consultation","id":"consultation","children":[["$","$L8",null,{"paragraphs":["Assessment covers skin quality, volume loss, the neck, and your general health and medication.","Photographs and 3D imaging describe the starting point and give the follow-up something to be measured against."]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":["$","$L4",null,{"to":"/contact-us","variant":"outline","children":"Contact the practice"}]}]]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"04","title":"Limitations","id":"limitations","children":["$","$L9",null,{"items":["Surgery repositions tissue; it does not stop ageing.","Skin texture, sun damage and pigmentation are not improved by lifting.","Volume that has been lost usually needs a separate answer.","Scars are permanent, even when placed where they are least visible."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"05","title":"Alternatives","id":"alternatives","children":["$","ul",null,{"className":"rule-t","children":[["$","li","Short scar facelift for earlier or more limited change",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/face-rejuvenation/short-scar-facelift","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Short scar facelift for earlier or more limited change"}]}],["$","li","Neck lift alone, where the neck is the whole concern",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/face-rejuvenation/deep-plane-neck-lift","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Neck lift alone, where the neck is the whole concern"}]}],["$","li","Fat transfer, where volume is the main issue",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/facial-sculpting/fat-transfer","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Fat transfer, where volume is the main issue"}]}],["$","li","Non-surgical treatment, including doing nothing for now",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/contact-us","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Non-surgical treatment, including doing nothing for now"}]}]]}]}]}],"$Lb","$Lc","$Ld","$Le"]}],"$Lf","$L10"]}],null,"$L11"]}],"isPartial":"$@12","staleTime":"$13","varyParams":null},{"rsc":"$L14","isPartial":"$@15","staleTime":"$13","varyParams":null},{"rsc":"$L16","isPartial":"$@17","staleTime":"$13","varyParams":"$18"}],"isUpgradeableISRFallback":false,"a":"$@19","rootVaryParams":null,"needsRuntimeRequest":"$@1a"}
