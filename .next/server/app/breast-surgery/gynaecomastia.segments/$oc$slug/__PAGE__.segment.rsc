0:{"buildId":"Fyt4YRq1IfdTy96UldKPE","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"children":[["$","$L2",null,{"items":[{"label":"Home","to":"/"},{"label":"Breast and torso surgery","to":"/breast-surgery"},{"label":"Gynaecomastia"}]}],["$","$L3",null,{"eyebrow":"Breast and torso surgery","title":"Gynaecomastia surgery","standfirst":"Breast tissue and fat in men, treated to restore a flat chest contour — and the reason it is worth investigating before operating.","image":"/assets/breasts-05.jpg","imageAlt":"Black and white study of the male chest and torso","actions":[["$","$L4",null,{"to":"/contact-us","children":"Book a consultation"}],["$","$L4",null,{"href":"#cases","variant":"outline","children":"View case studies"}]]}],["$","$L5",null,{"children":[["$","$L6",null,{"children":["$","$L7",null,{"index":"01","title":"The concern","id":"concern","children":["$","$L8",null,{"paragraphs":["Fullness of the male chest affects what men are willing to wear and whether they will swim or take their shirt off. It is common and rarely discussed.","It may be firm breast tissue, fat, or both, and the mix decides how it is treated."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"02","title":"Lucian's approach","id":"approach","children":["$","$L8",null,{"paragraphs":["Fat responds to liposuction; firm glandular tissue has to be excised directly. Most patients need some of each, which is why assessment comes first.","Where there is significant skin excess, managing the skin becomes part of the plan and changes what scars are involved."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"03","title":"The consultation","id":"consultation","children":[["$","$L8",null,{"paragraphs":["Assessment distinguishes glandular tissue from fat and considers medication, supplements and anything that might point to an underlying cause.","Investigations are sometimes advised before surgery is planned."]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":["$","$L4",null,{"to":"/contact-us","variant":"outline","children":"Contact the practice"}]}]]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"04","title":"Limitations","id":"limitations","children":["$","$L9",null,{"items":["Recurrence is possible, particularly if an underlying cause continues.","Skin retraction is not guaranteed, and loose skin may remain.","Some scarring around the areola is usual."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"05","title":"Alternatives","id":"alternatives","children":["$","ul",null,{"className":"rule-t","children":[["$","li","Investigating and treating an underlying cause first",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/contact-us","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Investigating and treating an underlying cause first"}]}],["$","li","Weight change, where the fullness is largely fat",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/contact-us","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Weight change, where the fullness is largely fat"}]}]]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"06","title":"Risks and complications","id":"risks","children":[["$","p",null,{"className":"measure mb-5 text-muted-foreground","children":"Every operation carries risk. This list is a starting point for the conversation, not a complete account; the risks that matter for you depend on your health and your anatomy and are discussed at consultation."}],["$","$L9",null,{"items":["Contour irregularity, over-correction or a dished appearance.","Changes in nipple sensation or position.","Recurrence.","Bleeding, infection and delayed healing are possible after any operation.","Scars are permanent. Their position is planned; how they mature varies between people and cannot be promised.","Swelling and bruising settle unevenly, so an early appearance is not the final one.","Numbness or altered sensation near the operated area is common early on and can occasionally persist.","Asymmetry exists in every face and body before surgery and can still be visible afterwards.","A result may fall short of what was hoped for, and revision surgery is sometimes considered.","Anaesthetic carries its own risks, which the anaesthetist discusses separately."]}]]}]}],"$Lb","$Lc","$Ld"]}],"$Le","$Lf"]}],null,"$L10"]}],"isPartial":"$@11","staleTime":"$12","varyParams":null},{"rsc":"$L13","isPartial":"$@14","staleTime":"$12","varyParams":null},{"rsc":"$L15","isPartial":"$@16","staleTime":"$12","varyParams":"$17"}],"isUpgradeableISRFallback":false,"a":"$@18","rootVaryParams":null,"needsRuntimeRequest":"$@19"}
