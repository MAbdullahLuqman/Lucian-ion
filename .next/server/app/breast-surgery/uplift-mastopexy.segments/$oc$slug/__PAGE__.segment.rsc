0:{"buildId":"Fyt4YRq1IfdTy96UldKPE","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"children":[["$","$L2",null,{"items":[{"label":"Home","to":"/"},{"label":"Breast and torso surgery","to":"/breast-surgery"},{"label":"Breast uplift / mastopexy"}]}],["$","$L3",null,{"eyebrow":"Breast and torso surgery","title":"Breast uplift (mastopexy)","standfirst":"Restoring position and shape rather than changing size — sometimes on its own, sometimes with a small implant.","image":"/assets/breasts-04.jpg","imageAlt":"Black and white torso study in low contrast light","actions":[["$","$L4",null,{"to":"/contact-us","children":"Book a consultation"}],["$","$L4",null,{"href":"#cases","variant":"outline","children":"View case studies"}]]}],["$","$L5",null,{"children":[["$","$L6",null,{"children":["$","$L7",null,{"index":"01","title":"The concern","id":"concern","children":["$","$L8",null,{"paragraphs":["After pregnancy, breastfeeding or weight change, breasts often keep their volume but lose position, and the upper part empties.","Patients frequently describe wanting their own breast back rather than a different one."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"02","title":"Lucian's approach","id":"approach","children":["$","$L8",null,{"paragraphs":["An uplift removes skin and reshapes the breast so it sits higher and fuller at the top. The scar pattern depends on how much lifting is needed.","Where upper fullness is what is missing, a small implant may be combined with the uplift; combining them has its own trade-offs, which are discussed openly."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"03","title":"The consultation","id":"consultation","children":[["$","$L8",null,{"paragraphs":["Assessment covers nipple position, skin quality, volume distribution and symmetry.","Whether to add an implant, and whether to do it in one stage or two, is discussed with the reasoning made explicit."]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":["$","$L4",null,{"to":"/contact-us","variant":"outline","children":"Contact the practice"}]}]]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"04","title":"Limitations","id":"limitations","children":["$","$L9",null,{"items":["An uplift does not add volume on its own.","Scars are permanent and vary in how they mature.","Some settling and recurrence of descent happens over time.","Skin quality limits how much shape can be held."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"05","title":"Alternatives","id":"alternatives","children":["$","ul",null,{"className":"rule-t","children":[["$","li","Breast augmentation alone, where position is acceptable",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/breast-surgery/augmentation","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Breast augmentation alone, where position is acceptable"}]}],["$","li","Breast reduction, where size is also a concern",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/breast-surgery/reduction","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Breast reduction, where size is also a concern"}]}]]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"06","title":"Risks and complications","id":"risks","children":[["$","p",null,{"className":"measure mb-5 text-muted-foreground","children":"Every operation carries risk. This list is a starting point for the conversation, not a complete account; the risks that matter for you depend on your health and your anatomy and are discussed at consultation."}],["$","$L9",null,{"items":["Delayed healing at the scars.","Changes in nipple sensation or position.","Recurrent descent, particularly if an implant is combined with the uplift.","Bleeding, infection and delayed healing are possible after any operation.","Scars are permanent. Their position is planned; how they mature varies between people and cannot be promised.","Swelling and bruising settle unevenly, so an early appearance is not the final one.","Numbness or altered sensation near the operated area is common early on and can occasionally persist.","Asymmetry exists in every face and body before surgery and can still be visible afterwards.","A result may fall short of what was hoped for, and revision surgery is sometimes considered.","Anaesthetic carries its own risks, which the anaesthetist discusses separately."]}]]}]}],"$Lb","$Lc","$Ld"]}],"$Le","$Lf"]}],null,"$L10"]}],"isPartial":"$@11","staleTime":"$12","varyParams":null},{"rsc":"$L13","isPartial":"$@14","staleTime":"$12","varyParams":null},{"rsc":"$L15","isPartial":"$@16","staleTime":"$12","varyParams":"$17"}],"isUpgradeableISRFallback":false,"a":"$@18","rootVaryParams":null,"needsRuntimeRequest":"$@19"}
