0:{"buildId":"Fyt4YRq1IfdTy96UldKPE","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"children":[["$","$L2",null,{"items":[{"label":"Home","to":"/"},{"label":"Breast and torso surgery","to":"/breast-surgery"},{"label":"Breast reduction"}]}],["$","$L3",null,{"eyebrow":"Breast and torso surgery","title":"Breast reduction","standfirst":"Reducing size, and at the same time reshaping and lifting — the two happen together rather than separately.","image":"/assets/breasts-03.jpg","imageAlt":"Black and white torso study, soft directional light","actions":[["$","$L4",null,{"to":"/contact-us","children":"Book a consultation"}],["$","$L4",null,{"href":"#cases","variant":"outline","children":"View case studies"}]]}],["$","$L5",null,{"children":[["$","$L6",null,{"children":["$","$L7",null,{"index":"01","title":"The concern","id":"concern","children":["$","$L8",null,{"paragraphs":["Large breasts can cause neck, shoulder and back discomfort, skin irritation, difficulty with exercise and a limited choice of clothing. For many patients the physical symptoms matter as much as the appearance.","Asymmetry is frequently part of the picture and is addressed in the same operation."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"02","title":"Lucian's approach","id":"approach","children":["$","$L8",null,{"paragraphs":["Reduction removes tissue and reshapes what remains, moving the nipple to a position that matches the new shape. The scar pattern follows from how much is being removed.","The balance between how much is removed, the final shape and the length of the scars is decided with you, not for you."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"03","title":"The consultation","id":"consultation","children":[["$","$L8",null,{"paragraphs":["Assessment covers size, shape, skin quality, nipple position and any symptoms you have.","Scar patterns are explained and drawn, along with what each one allows."]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":["$","$L4",null,{"to":"/contact-us","variant":"outline","children":"Contact the practice"}]}]]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"04","title":"Limitations","id":"limitations","children":["$","$L9",null,{"items":["Scars are unavoidable and permanent.","Nipple sensation may change, and breastfeeding may be affected.","Breasts continue to change afterwards with weight and time.","Complete symmetry is not achievable."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"05","title":"Alternatives","id":"alternatives","children":["$","ul",null,{"className":"rule-t","children":[["$","li","Breast uplift where size is acceptable but position is not",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/breast-surgery/uplift-mastopexy","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Breast uplift where size is acceptable but position is not"}]}],["$","li","Non-surgical measures, including support and physiotherapy",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/contact-us","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Non-surgical measures, including support and physiotherapy"}]}]]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"06","title":"Risks and complications","id":"risks","children":[["$","p",null,{"className":"measure mb-5 text-muted-foreground","children":"Every operation carries risk. This list is a starting point for the conversation, not a complete account; the risks that matter for you depend on your health and your anatomy and are discussed at consultation."}],["$","$L9",null,{"items":["Delayed healing where the scars meet, which is not unusual.","Loss of nipple sensation, and rarely problems with nipple blood supply.","Asymmetry of shape, size or nipple position.","Bleeding, infection and delayed healing are possible after any operation.","Scars are permanent. Their position is planned; how they mature varies between people and cannot be promised.","Swelling and bruising settle unevenly, so an early appearance is not the final one.","Numbness or altered sensation near the operated area is common early on and can occasionally persist.","Asymmetry exists in every face and body before surgery and can still be visible afterwards.","A result may fall short of what was hoped for, and revision surgery is sometimes considered.","Anaesthetic carries its own risks, which the anaesthetist discusses separately."]}]]}]}],"$Lb","$Lc","$Ld"]}],"$Le","$Lf"]}],null,"$L10"]}],"isPartial":"$@11","staleTime":"$12","varyParams":null},{"rsc":"$L13","isPartial":"$@14","staleTime":"$12","varyParams":null},{"rsc":"$L15","isPartial":"$@16","staleTime":"$12","varyParams":"$17"}],"isUpgradeableISRFallback":false,"a":"$@18","rootVaryParams":null,"needsRuntimeRequest":"$@19"}
