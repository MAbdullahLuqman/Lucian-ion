0:{"buildId":"Fyt4YRq1IfdTy96UldKPE","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"children":[["$","$L2",null,{"items":[{"label":"Home","to":"/"},{"label":"Facial sculpting","to":"/facial-sculpting"},{"label":"Anterior neck lift"}]}],["$","$L3",null,{"eyebrow":"Facial sculpting","title":"Anterior neck lift","standfirst":"Fullness and banding under the chin, treated from the front of the neck rather than from the sides.","image":"/assets/sculpting-04.jpg","imageAlt":"Black and white study of the neck and jawline in profile","actions":[["$","$L4",null,{"to":"/contact-us","children":"Book a consultation"}],["$","$L4",null,{"href":"#cases","variant":"outline","children":"View case studies"}]]}],["$","$L5",null,{"children":[["$","$L6",null,{"children":["$","$L7",null,{"index":"01","title":"The concern","id":"concern","children":["$","$L8",null,{"paragraphs":["An indistinct line between the chin and the neck is one of the earliest things people notice in photographs, often before any other sign of ageing.","What sits behind it varies: fat above or below the muscle, muscle bands that have separated, loose skin, or a chin that sits back."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"02","title":"Lucian's approach","id":"approach","children":["$","$L8",null,{"paragraphs":["An anterior approach works directly on the structures under the chin and suits patients whose problem is central rather than spread along the jawline.","Where laxity extends to the sides of the neck, a wider operation is usually the more honest answer, and that is discussed rather than stretched to fit."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"03","title":"The consultation","id":"consultation","children":[["$","$L8",null,{"paragraphs":["Examination looks at where the fullness sits, how the muscle behaves and how much skin is loose, as well as at chin position.","Photographs and imaging record the starting point in a way that makes follow-up meaningful."]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":["$","$L4",null,{"to":"/contact-us","variant":"outline","children":"Contact the practice"}]}]]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"04","title":"Limitations","id":"limitations","children":["$","$L9",null,{"items":["It addresses the central neck. Laxity along the jawline needs a different operation.","Skin quality limits how sharply a contour can be defined.","Ageing continues and the neck will change again."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"05","title":"Alternatives","id":"alternatives","children":["$","ul",null,{"className":"rule-t","children":[["$","li","Deep plane neck lift for wider laxity",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/face-rejuvenation/deep-plane-neck-lift","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Deep plane neck lift for wider laxity"}]}],["$","li","Chin augmentation, where chin position is the cause",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/facial-sculpting/chin-augmentation","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Chin augmentation, where chin position is the cause"}]}],["$","li","Facial liposuction, where the issue is fat alone",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/facial-sculpting/facial-liposuction","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Facial liposuction, where the issue is fat alone"}]}]]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"06","title":"Risks and complications","id":"risks","children":[["$","p",null,{"className":"measure mb-5 text-muted-foreground","children":"Every operation carries risk. This list is a starting point for the conversation, not a complete account; the risks that matter for you depend on your health and your anatomy and are discussed at consultation."}],"$Lb"]}]}],"$Lc","$Ld","$Le"]}],"$Lf","$L10"]}],null,"$L11"]}],"isPartial":"$@12","staleTime":"$13","varyParams":null},{"rsc":"$L14","isPartial":"$@15","staleTime":"$13","varyParams":null},{"rsc":"$L16","isPartial":"$@17","staleTime":"$13","varyParams":"$18"}],"isUpgradeableISRFallback":false,"a":"$@19","rootVaryParams":null,"needsRuntimeRequest":"$@1a"}
