0:{"buildId":"Fyt4YRq1IfdTy96UldKPE","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"children":[["$","$L2",null,{"items":[{"label":"Home","to":"/"},{"label":"Facial sculpting","to":"/facial-sculpting"},{"label":"Cheek implants"}]}],["$","$L3",null,{"eyebrow":"Facial sculpting","title":"Cheek implants","standfirst":"Where the midface is flat structurally rather than simply deflated, support can be added to the bone itself.","image":"/assets/sculpting-03.jpg","imageAlt":"Black and white portrait study, cheekbone in raking light","actions":[["$","$L4",null,{"to":"/contact-us","children":"Book a consultation"}],["$","$L4",null,{"href":"#cases","variant":"outline","children":"View case studies"}]]}],["$","$L5",null,{"children":[["$","$L6",null,{"children":["$","$L7",null,{"index":"01","title":"The concern","id":"concern","children":["$","$L8",null,{"paragraphs":["Flat cheeks can make the midface look tired at any age and can leave the lower lids looking hollow. The question is always whether the shortfall is in the bone or in the soft tissue over it.","That distinction decides whether an implant or a volume procedure is the better answer."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"02","title":"Lucian's approach","id":"approach","children":["$","$L8",null,{"paragraphs":["An implant changes the framework permanently and in a shape that is chosen in advance. It suits patients whose cheek projection was never there, more than those who have lost volume over time.","Where the shortfall is soft tissue, fat transfer is usually the more appropriate route and is discussed on its own page."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"03","title":"The consultation","id":"consultation","children":[["$","$L8",null,{"paragraphs":["Assessment separates bony projection from soft tissue volume, using photographs and 3D imaging.","Position matters more than size, and that is what the imaging is used to agree."]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":["$","$L4",null,{"to":"/contact-us","variant":"outline","children":"Contact the practice"}]}]]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"04","title":"Limitations","id":"limitations","children":["$","$L9",null,{"items":["An implant does not improve skin quality or lift descended tissue.","It is a permanent device and may need revision or removal at some point.","Facial asymmetry is usually still visible afterwards."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"05","title":"Alternatives","id":"alternatives","children":["$","ul",null,{"className":"rule-t","children":[["$","li","Fat transfer, where volume rather than structure is missing",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/facial-sculpting/fat-transfer","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Fat transfer, where volume rather than structure is missing"}]}],["$","li","Facelift, where the tissue has descended",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/face-rejuvenation/facelift","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Facelift, where the tissue has descended"}]}]]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"06","title":"Risks and complications","id":"risks","children":[["$","p",null,{"className":"measure mb-5 text-muted-foreground","children":"Every operation carries risk. This list is a starting point for the conversation, not a complete account; the risks that matter for you depend on your health and your anatomy and are discussed at consultation."}],["$","$L9",null,{"items":["Implant movement, visibility, infection or the need for removal.","Altered sensation over the cheek.","Bleeding, infection and delayed healing are possible after any operation.","Scars are permanent. Their position is planned; how they mature varies between people and cannot be promised.","Swelling and bruising settle unevenly, so an early appearance is not the final one.","Numbness or altered sensation near the operated area is common early on and can occasionally persist.","Asymmetry exists in every face and body before surgery and can still be visible afterwards.","A result may fall short of what was hoped for, and revision surgery is sometimes considered.","Anaesthetic carries its own risks, which the anaesthetist discusses separately."]}]]}]}],"$Lb","$Lc","$Ld"]}],"$Le","$Lf"]}],null,"$L10"]}],"isPartial":"$@11","staleTime":"$12","varyParams":null},{"rsc":"$L13","isPartial":"$@14","staleTime":"$12","varyParams":null},{"rsc":"$L15","isPartial":"$@16","staleTime":"$12","varyParams":"$17"}],"isUpgradeableISRFallback":false,"a":"$@18","rootVaryParams":null,"needsRuntimeRequest":"$@19"}
