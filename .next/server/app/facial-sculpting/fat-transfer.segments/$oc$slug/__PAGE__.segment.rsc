0:{"buildId":"Fyt4YRq1IfdTy96UldKPE","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"children":[["$","$L2",null,{"items":[{"label":"Home","to":"/"},{"label":"Facial sculpting","to":"/facial-sculpting"},{"label":"Fat transfer"}]}],["$","$L3",null,{"eyebrow":"Facial sculpting","title":"Fat transfer","standfirst":"Using your own fat to restore volume where it has been lost — usually the temples, the midface and the area around the eyes.","image":"/assets/sculpting-06.jpg","imageAlt":"Black and white portrait study, soft light across the midface","actions":[["$","$L4",null,{"to":"/contact-us","children":"Book a consultation"}],["$","$L4",null,{"href":"#cases","variant":"outline","children":"View case studies"}]]}],["$","$L5",null,{"children":[["$","$L6",null,{"children":["$","$L7",null,{"index":"01","title":"The concern","id":"concern","children":["$","$L8",null,{"paragraphs":["Volume loss reads as tiredness rather than as ageing, and it is often what people mean when they say they look drawn. Lifting tissue does not replace what is no longer there.","Fat transfer answers the volume part of that picture and is very often combined with other work."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"02","title":"Lucian's approach","id":"approach","children":["$","$L8",null,{"paragraphs":["Fat is taken from elsewhere on the body, prepared, and placed in small amounts in several layers so that it has a blood supply to survive on.","Not all of it survives, and how much does varies between people. That is why more than one session is sometimes needed and why the plan is conservative."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"03","title":"The consultation","id":"consultation","children":[["$","$L8",null,{"paragraphs":["Assessment identifies where volume is genuinely missing, as opposed to where tissue has descended.","A donor area is discussed, along with the recovery that comes with it."]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":["$","$L4",null,{"to":"/contact-us","variant":"outline","children":"Contact the practice"}]}]]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"04","title":"Limitations","id":"limitations","children":["$","$L9",null,{"items":["Survival of transferred fat is unpredictable and a second session may be needed.","It adds volume; it does not lift or tighten.","Results change if your weight changes significantly."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"05","title":"Alternatives","id":"alternatives","children":["$","ul",null,{"className":"rule-t","children":[["$","li","Cheek implants, where the shortfall is structural",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/facial-sculpting/cheek-implants","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Cheek implants, where the shortfall is structural"}]}],["$","li","Facelift, where tissue has descended",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/face-rejuvenation/facelift","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Facelift, where tissue has descended"}]}]]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"06","title":"Risks and complications","id":"risks","children":[["$","p",null,{"className":"measure mb-5 text-muted-foreground","children":"Every operation carries risk. This list is a starting point for the conversation, not a complete account; the risks that matter for you depend on your health and your anatomy and are discussed at consultation."}],["$","$L9",null,{"items":["Uneven or incomplete survival of the transferred fat.","Lumpiness, particularly in thin-skinned areas.","Recovery at the donor site as well as the face.","Bleeding, infection and delayed healing are possible after any operation.","Scars are permanent. Their position is planned; how they mature varies between people and cannot be promised.","Swelling and bruising settle unevenly, so an early appearance is not the final one.","Numbness or altered sensation near the operated area is common early on and can occasionally persist.","Asymmetry exists in every face and body before surgery and can still be visible afterwards.","A result may fall short of what was hoped for, and revision surgery is sometimes considered.","Anaesthetic carries its own risks, which the anaesthetist discusses separately."]}]]}]}],"$Lb","$Lc","$Ld"]}],"$Le","$Lf"]}],null,"$L10"]}],"isPartial":"$@11","staleTime":"$12","varyParams":null},{"rsc":"$L13","isPartial":"$@14","staleTime":"$12","varyParams":null},{"rsc":"$L15","isPartial":"$@16","staleTime":"$12","varyParams":"$17"}],"isUpgradeableISRFallback":false,"a":"$@18","rootVaryParams":null,"needsRuntimeRequest":"$@19"}
