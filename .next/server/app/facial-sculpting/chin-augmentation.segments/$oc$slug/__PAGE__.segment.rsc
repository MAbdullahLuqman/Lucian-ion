0:{"buildId":"Fyt4YRq1IfdTy96UldKPE","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"children":[["$","$L2",null,{"items":[{"label":"Home","to":"/"},{"label":"Facial sculpting","to":"/facial-sculpting"},{"label":"Chin augmentation"}]}],["$","$L3",null,{"eyebrow":"Facial sculpting","title":"Chin augmentation","standfirst":"A chin that sits back changes how the nose, the jawline and the neck are read. Adjusting it is often the quietest way to alter a profile.","image":"/assets/sculpting-02.jpg","imageAlt":"Black and white profile study of chin and jawline","actions":[["$","$L4",null,{"to":"/contact-us","children":"Book a consultation"}],["$","$L4",null,{"href":"#cases","variant":"outline","children":"View case studies"}]]}],["$","$L5",null,{"children":[["$","$L6",null,{"children":["$","$L7",null,{"index":"01","title":"The concern","id":"concern","children":["$","$L8",null,{"paragraphs":["Many people who dislike their profile point at their nose when the chin is doing at least half of the work. A recessed chin also tends to make the under-chin area look fuller than it is.","The change patients usually want is definition, not size."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"02","title":"Lucian's approach","id":"approach","children":["$","$L8",null,{"paragraphs":["Chin position can be altered by adding to the bone or by moving it, and the two routes suit different patients. The choice is made on the shape of the face and the amount of change needed.","Because chin, jawline and neck read together, this is frequently planned alongside neck or nose work rather than alone."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"03","title":"The consultation","id":"consultation","children":[["$","$L8",null,{"paragraphs":["Assessment covers the profile, the bite, the position of the lower lip and the shape of the neck.","3D imaging is used to show the effect of a change in proportion before anything is decided."]}],["$","div",null,{"className":"mt-6 flex flex-wrap gap-3","children":["$","$L4",null,{"to":"/contact-us","variant":"outline","children":"Contact the practice"}]}]]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"04","title":"Limitations","id":"limitations","children":["$","$L9",null,{"items":["It changes the framework, not the quality of the skin over it.","A bite problem is a dental and orthodontic matter and is not corrected by contour surgery.","Sensation in the lip and chin takes time to settle."]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"05","title":"Alternatives","id":"alternatives","children":["$","ul",null,{"className":"rule-t","children":[["$","li","Anterior neck lift, where the under-chin area is the concern",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/facial-sculpting/anterior-neck-lift","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Anterior neck lift, where the under-chin area is the concern"}]}],["$","li","Rhinoplasty, where the nose is the dominant feature",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/rhinoplasty/reduction","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Rhinoplasty, where the nose is the dominant feature"}]}],["$","li","Non-surgical contouring, where a temporary change is enough",{"className":"rule-b py-3","children":["$","$La",null,{"href":"/contact-us","className":"text-[1.0625rem] leading-relaxed text-foreground/85 underline decoration-rule underline-offset-4 hover:decoration-foreground","children":"Non-surgical contouring, where a temporary change is enough"}]}]]}]}]}],["$","$L6",null,{"children":["$","$L7",null,{"index":"06","title":"Risks and complications","id":"risks","children":[["$","p",null,{"className":"measure mb-5 text-muted-foreground","children":"Every operation carries risk. This list is a starting point for the conversation, not a complete account; the risks that matter for you depend on your health and your anatomy and are discussed at consultation."}],"$Lb"]}]}],"$Lc","$Ld","$Le"]}],"$Lf","$L10"]}],null,"$L11"]}],"isPartial":"$@12","staleTime":"$13","varyParams":null},{"rsc":"$L14","isPartial":"$@15","staleTime":"$13","varyParams":null},{"rsc":"$L16","isPartial":"$@17","staleTime":"$13","varyParams":"$18"}],"isUpgradeableISRFallback":false,"a":"$@19","rootVaryParams":null,"needsRuntimeRequest":"$@1a"}
